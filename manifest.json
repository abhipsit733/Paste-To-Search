{
  "manifest_version": 3,
  "name": "Paste-To-Search",
  "short_name": "PasteToSearch",
  "version": "1.0.0",
  "description": "Paste or drop an image, ask an optional question, and search it on Google.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://images.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://images.google.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Open Paste-To-Search"
    }
  }
}
